{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "type": "object",
  "properties": {
    "document": {
      "$ref": "#/$defs/DocumentInfo"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageReport"
      }
    },
    "schema": {
      "description": "Always [`SCHEMA_ID`].",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "document",
    "pages",
    "schema"
  ],
  "$defs": {
    "Binarizer": {
      "type": "string",
      "enum": [
        "otsu",
        "sauvola",
        "wolf",
        "howe"
      ]
    },
    "DocumentInfo": {
      "type": "object",
      "properties": {
        "incremental_updates": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "producer": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string"
        },
        "source": {
          "description": "`pdf`, `image` or `raw`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "incremental_updates",
        "pages",
        "producer",
        "sha256",
        "source"
      ]
    },
    "Evidence": {
      "description": "One named measurement and its signed contribution to a finding's log-odds.",
      "type": "object",
      "properties": {
        "citation": {
          "description": "Source the feature or threshold comes from, or \"tuned on <set>\".",
          "type": "string"
        },
        "detector": {
          "description": "Dotted detector id, e.g. `stamp.color_cluster`.",
          "type": "string"
        },
        "feature": {
          "description": "Feature name, e.g. `hue_cluster_compactness`.",
          "type": "string"
        },
        "llr": {
          "description": "Signed log-likelihood-ratio contribution to the finding.",
          "type": "number",
          "format": "double"
        },
        "note": {
          "type": "string"
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "citation",
        "detector",
        "feature",
        "llr",
        "note",
        "threshold",
        "value"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "bbox": {
          "description": "`[x0, y0, x1, y1]` in page pixel coordinates at the analysis DPI.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "confidence": {
          "description": "Calibrated confidence in [0, 1].",
          "type": "number",
          "format": "double"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "polygon": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "maxItems": 2,
            "minItems": 2
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "attributes",
        "bbox",
        "confidence",
        "evidence",
        "kind",
        "polygon"
      ]
    },
    "GenerationEstimate": {
      "type": "object",
      "properties": {
        "confidence": {
          "description": "Capped at 0.6: the method is experimental (module M3).",
          "type": "number",
          "format": "double"
        },
        "value": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "confidence",
        "value"
      ]
    },
    "Kind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "text_layer",
            "script",
            "language_hint",
            "printed_text",
            "handwriting",
            "signature",
            "stamp",
            "seal",
            "embossed_seal",
            "thumb_impression",
            "barcode_1d",
            "qr_code",
            "estamp_qr",
            "stamp_paper_header",
            "registrar_endorsement",
            "page_number_margin",
            "table",
            "ruling_lines",
            "checkbox_grid",
            "fold_line",
            "photo",
            "vector_graphic",
            "redaction_box",
            "blank_page"
          ]
        },
        {
          "description": "Text on the page that the supplied text layer or OCR boxes do not cover.",
          "type": "string",
          "const": "extraction_gap"
        },
        {
          "description": "The page's text does not run left to right with its tops up; `rotate_clockwise_deg` says how to turn it.",
          "type": "string",
          "const": "misoriented"
        }
      ]
    },
    "PageLabel": {
      "type": "string",
      "enum": [
        "text",
        "text_with_annotations",
        "form",
        "table",
        "photo",
        "mixed",
        "blank",
        "cover_stamp_paper"
      ]
    },
    "PagePlan": {
      "description": "Deterministic instructions for whatever reads this page next (an OCR engine, a handwriting model, a\nvision-language model): how to turn and scale the page, which pieces to send where, which to skip.",
      "type": "object",
      "properties": {
        "binarizer": {
          "description": "The binarisation method to use before OCR (module M3).",
          "type": "string"
        },
        "content_bbox": {
          "description": "Box of everything worth reading, with a margin, in the page as given; the whole page if nothing\nwas found.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "deskew_clockwise_deg": {
          "description": "Then turn it this many degrees clockwise to level its lines (the measured skew, so a page whose\ntext rises to the right is turned clockwise). `None` when the page needs a quarter turn first:\nthe skew and the regions below were measured on it sideways.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "difficulty": {
          "description": "0 (easy) to 1 (hard): a rough budget guide, not a probability.",
          "type": "number",
          "format": "double"
        },
        "input_sha256": {
          "description": "SHA-256 of the pixels, size and resolution: the same page always has the same key.",
          "type": "string"
        },
        "needs_rerun": {
          "description": "The page was read sideways or upside down: analyse the rotated image again for regions.",
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanRegion"
          }
        },
        "rotate_clockwise_deg": {
          "description": "Turn the page this many degrees clockwise first (0, 90, 180 or 270).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "scale": {
          "$ref": "#/$defs/PlanScale"
        },
        "scripts": {
          "description": "Scripts the page is probably written in, from the script detector, most likely first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanSkip"
            },
            {
              "type": "null"
            }
          ]
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanTile"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "binarizer",
        "content_bbox",
        "deskew_clockwise_deg",
        "difficulty",
        "input_sha256",
        "needs_rerun",
        "notes",
        "regions",
        "rotate_clockwise_deg",
        "scale",
        "scripts",
        "skip",
        "tiles"
      ]
    },
    "PageReport": {
      "type": "object",
      "properties": {
        "analysis_dpi": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "debug": {
          "description": "Raw detector feature values, present only when `debug` is requested. Keyed\n`detector -> feature -> value`; this is what `bench/` uses to tune `params/*.toml`.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "dhash": {
          "description": "64-bit difference hash, same format as `phash`.",
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "near_duplicate_of": {
          "description": "`index` of the earliest earlier page whose hashes are within the near-duplicate distance.\nOne page cannot know its twins, so this is filled by the document-level step\n(`pixel::phash::mark_near_duplicates`), not by `analyse_page`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "page_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageType"
            },
            {
              "type": "null"
            }
          ]
        },
        "phash": {
          "description": "64-bit perceptual hash as 16 lowercase hex characters (module M12); all zeros for a page\nwith no structure to hash.",
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "description": "What to do with the page next; present when the `plan` detector is selected.",
          "anyOf": [
            {
              "$ref": "#/$defs/PagePlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quality"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_pt": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "text_layer": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextLayer"
            },
            {
              "type": "null"
            }
          ]
        },
        "timings_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timings"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "analysis_dpi",
        "debug",
        "dhash",
        "findings",
        "index",
        "near_duplicate_of",
        "page_type",
        "phash",
        "plan",
        "quality",
        "size_pt",
        "text_layer",
        "timings_ms"
      ]
    },
    "PageType": {
      "type": "object",
      "properties": {
        "alternatives": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "label": {
          "$ref": "#/$defs/PageLabel"
        }
      },
      "additionalProperties": false,
      "required": [
        "alternatives",
        "confidence",
        "label"
      ]
    },
    "PlanRegion": {
      "description": "A piece of the page and where to send it.",
      "type": "object",
      "properties": {
        "bbox": {
          "description": "`[x0, y0, x1, y1]` in the page as given (before any rotation or deskew), pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "kind": {
          "description": "`text_block`, `table`, `handwriting`, `signature`, `stamp`, `seal`, `embossed_seal`,\n`thumb_impression`, `photo`, `qr_code`, `checkbox_grid` or `redaction_box`.",
          "type": "string"
        },
        "priority": {
          "description": "0 reads first (text, tables, handwriting), 1 next (marks and pictures), 2 last (codes, notes).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "route": {
          "description": "`ocr`, `table`, `handwriting`, `mark`, `vision`, `decoded`, `decode`, `fields` or `note`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "bbox",
        "kind",
        "priority",
        "route"
      ]
    },
    "PlanScale": {
      "description": "How much to enlarge or shrink the page for a downstream reader (OCR engines read best at a\ncharacter size of a few dozen pixels).",
      "type": "object",
      "properties": {
        "factor": {
          "description": "Multiply the page's size by this (1.0 leaves it).",
          "type": "number",
          "format": "double"
        },
        "suggested_dpi": {
          "description": "The resolution that factor corresponds to, given the analysis dpi.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "target_xheight_px": {
          "type": "number",
          "format": "double"
        },
        "xheight_px": {
          "description": "Measured height of a lower-case letter, pixels, as the page is.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "factor",
        "suggested_dpi",
        "target_xheight_px",
        "xheight_px"
      ]
    },
    "PlanSkip": {
      "description": "Why a page need not be sent anywhere.",
      "type": "object",
      "properties": {
        "of": {
          "description": "For a near-duplicate: the `index` of the earlier page it repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "reason": {
          "description": "`blank` or `near_duplicate`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "of",
        "reason"
      ]
    },
    "PlanTile": {
      "description": "A tile of a page too big to send whole, cut along empty rows and columns, overlapping its neighbours.",
      "type": "object",
      "properties": {
        "bbox": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "column": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "bbox",
        "column",
        "row"
      ]
    },
    "Quality": {
      "description": "Degradation triage (module M3, Phase 1).",
      "type": "object",
      "properties": {
        "bleed_through": {
          "type": "number",
          "format": "double"
        },
        "blur_laplacian_var": {
          "type": "number",
          "format": "double"
        },
        "contrast_rms": {
          "type": "number",
          "format": "double"
        },
        "fold_lines": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "grade": {
          "description": "Letter grade; the scale is defined in Phase 1.",
          "type": "string"
        },
        "photocopy_generation_est": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationEstimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_binarizer": {
          "$ref": "#/$defs/Binarizer"
        },
        "skew_deg": {
          "type": "number",
          "format": "double"
        },
        "speckle_density": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "bleed_through",
        "blur_laplacian_var",
        "contrast_rms",
        "fold_lines",
        "grade",
        "photocopy_generation_est",
        "recommended_binarizer",
        "skew_deg",
        "speckle_density"
      ]
    },
    "TextLayer": {
      "description": "Structural text-layer verdict (module M1, Phase 1).",
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "reliable": {
          "description": "False when the layer is legacy-encoded or garbled (module M2).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/TextLayerState"
        }
      },
      "additionalProperties": false,
      "required": [
        "confidence",
        "evidence",
        "reliable",
        "state"
      ]
    },
    "TextLayerState": {
      "type": "string",
      "enum": [
        "native_text",
        "raster_only",
        "invisible_ocr_under_image",
        "mixed",
        "vector_only",
        "empty"
      ]
    },
    "Timings": {
      "description": "Wall-clock timings are measured by the host (CLI, bindings), never by the core: they differ run\nto run, and `std::time::Instant` is unavailable on `wasm32-unknown-unknown`. The core always\nleaves this `None`, which keeps the report byte-reproducible.",
      "type": "object",
      "properties": {
        "fusion": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "pixel": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "structural": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "fusion",
        "pixel",
        "structural"
      ]
    }
  }
}
